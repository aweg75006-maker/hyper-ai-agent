# Do not commit .env. Copy this file to .env and fill in the real values.
# All three providers accept OpenAI-compatible requests.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Spring AI Alibaba uses AI_DASHSCOPE_API_KEY. The DashScope Java SDK uses
# DASHSCOPE_API_KEY, so set both to the same key when using that SDK directly.
AI_DASHSCOPE_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# Used by the live model-discovery test (OpenAI-compatible API).
DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
